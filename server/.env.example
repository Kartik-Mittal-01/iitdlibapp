# Copy to server/.env and fill in. Never commit .env.

# --- Server -------------------------------------------------------------------
NODE_ENV=development
# 5000 conflicts with macOS AirPlay Receiver; the default is 5001.
PORT=5001
# Set to 1 (or a hop count / subnet) when running behind a reverse proxy.
TRUST_PROXY=

# --- MongoDB ------------------------------------------------------------------
# A replica set (or Atlas) enables multi-document transactions. A standalone
# server also works (conditional updates + automatic reconciliation).
MONGODB_URI=mongodb://127.0.0.1:27017/iitd_library

# --- Secrets (generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=replace-with-at-least-32-random-characters
# HMAC key for RFID card UIDs. Changing it invalidates every registered card.
CARD_UID_PEPPER=replace-with-at-least-32-random-characters

# Token lifetimes (jsonwebtoken / ms format)
STUDENT_TOKEN_TTL=12h
STAFF_TOKEN_TTL=8h
TERMINAL_TOKEN_TTL=12h

# --- CORS -----------------------------------------------------------------------
# Dev renderer origins of entrygate-app (5173), exitgate-app (5174) and commonapp (5175).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Packaged Electron apps load from file:// and send "Origin: null".
CORS_ALLOW_NULL_ORIGIN=true

# --- Student registration policy -----------------------------------------------
# Comma-separated allowed email domains for student registration.
STUDENT_EMAIL_DOMAINS=iitd.ac.in
# Also allow department subdomains such as cse.iitd.ac.in.
STUDENT_EMAIL_ALLOW_SUBDOMAINS=true

# --- Email (registration OTP codes) ---------------------------------------------
# Student registration sends a 6-digit code to the student's IIT Delhi email.
# Without these, registration reports EMAIL_NOT_CONFIGURED (nothing is faked).
# Gmail / Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, an App Password
# as SMTP_PASS (requires 2-step verification). Office 365: smtp.office365.com:587.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true = implicit TLS (port 465). Leave empty to choose from the port (STARTTLS on 587).
SMTP_SECURE=
SMTP_USER=library-mailer@example.com
SMTP_PASS=replace-with-smtp-password-or-app-password
SMTP_FROM="IIT Delhi Central Library <library-mailer@example.com>"

# --- Tuning -------------------------------------------------------------------
BCRYPT_ROUNDS=12
# How long a card scan stays valid for completing entry/exit at the kiosk.
SCAN_TOKEN_TTL_SECONDS=120
# How often the hold-expiry worker sweeps (expired holds are also handled lazily).
HOLD_SWEEP_INTERVAL_MS=15000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_REGISTER_MAX=20
# Per client IP per 15 minutes (per-email: 60 s resend cooldown, 5 codes/hour, 5 attempts/code).
RATE_LIMIT_OTP_REQUEST_MAX=10
RATE_LIMIT_OTP_VERIFY_MAX=30
RATE_LIMIT_GATE_MAX=120
RATE_LIMIT_API_MAX=600

# Optional: used only by `npm run create-admin` for non-interactive provisioning.
# ADMIN_BOOTSTRAP_PASSWORD=
# Optional: used only by `npm run seed -- --with-test-data`.
# SEED_STUDENT_PASSWORD=
