{
  "name": "server",
  "version": "1.0.0",
  "description": "IITD Library Management System API (Express + MongoDB + Socket.IO)",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test": "node --test --test-concurrency=1 'test/**/*.test.js'",
    "test:standalone": "TEST_MONGO_TOPOLOGY=standalone node --test --test-concurrency=1 'test/**/*.test.js'",
    "lint": "node --check src/index.js && find src scripts test -name '*.js' -exec node --check {} +",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "create-terminal": "node scripts/create-terminal.js",
    "register-card": "node scripts/register-card.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "nodemailer": "10.0.14",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=20.19"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "../shared"
    ],
    "ext": "js,mjs,json"
  }
}
